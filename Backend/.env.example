# Copy this file to ".env" and fill in your values.
# The .env file holds secrets - it is listed in .gitignore and is never uploaded to GitHub.

# ---- Server ----
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
# The React client address(es) allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345678
DB_NAME=chatgpt_clone

# ---- OpenAI ----
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna
SYSTEM_PROMPT=You are a helpful assistant.
# How many previous messages are sent to OpenAI as the conversation context
MAX_CONTEXT_MESSAGES=100
